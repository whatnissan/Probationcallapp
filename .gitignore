# Dependencies
node_modules/

# Apple Sign In signing key — must NEVER be committed. The .p8 downloads
# exactly once from the Apple Developer portal; it exists on disk only long
# enough to generate the Supabase client secret, and lives nowhere in git.
*.p8

# Environment variables
.env
.env.local
.env.*.local
.env.production

# Stale copies — never track backups of live code
*.bak
*.backup

# Logs
logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build outputs
dist/
build/
